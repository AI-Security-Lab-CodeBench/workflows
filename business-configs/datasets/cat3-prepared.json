{
  "dataset_id": "cloud_infrastructure_commands",
  "revision": "cat3-prepared",
  "existing_datasets": {
    "sources": {
      "manifest": "../manifests/cat3/datasets.json"
    },
    "snapshot": { "maximum_bytes": 10485760, "workers": 8 },
    "adapters": { "mode": "provided", "sample_characters": 8000 },
    "extraction": { "context_characters": 100 }
  },
  "documentation_crawl": {
    "sources": {
      "manifest": "../manifests/cat3/documentation-sources.json"
    },
    "snapshot": { "maximum_bytes": 10485760, "workers": 8 },
    "adapters": { "mode": "provided", "sample_characters": 8000 },
    "extraction": { "context_characters": 100 }
  },
  "finalization": {
    "filtering": {
      "maximum_command_characters": 32768,
      "quarantine_dynamic_shell": true
    },
    "documentation": {
      "mode": "provided_snippets",
      "manifest": "../manifests/cat3/semantics.json",
      "maximum_bytes": 10485760
    },
    "business_config": "../categories/cat3/category.json",
    "annotation": {
      "model": {
        "provider": "native",
        "model": "chatgpt-subscription/gpt-6-luna",
        "timeout_seconds": 900
      },
      "maximum_context_characters": 131072,
      "workers": 4,
      "batch": null
    },
    "publication": {
      "limit_per_risk": 250,
      "review_columns": ["command", "category_id", "risk_id", "severity", "class"]
    }
  },
  "storage": null
}
