# Deployment settings for docker compose --env-file. Use different random passwords.
CODEBENCH_POSTGRES_ADMIN_PASSWORD=
CODEBENCH_REVIEW_DATABASE_PASSWORD=
CODEBENCH_PIPELINE_ENV_FILE=.env.pipeline
CODEBENCH_LLM_IP=

# Optional additional Keenable organizations: put these in .env.pipeline, not here.
# KEENABLE_API_KEY_1=
# KEENABLE_API_KEY_2=
# Use the same nonsecret label only for keys sharing one organization's quota.
# KEENABLE_ORG=primary
# KEENABLE_ORG_1=second
# KEENABLE_ORG_2=third
